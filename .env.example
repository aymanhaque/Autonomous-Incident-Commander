# LLM Provider — use Gemini (cloud) or Ollama (local/offline)
GEMINI_API_KEY=your-gemini-api-key
# OLLAMA_BASE_URL=http://localhost:11434   # uncomment for local Ollama

# Firestore (production / staging — real GCP)
FIRESTORE_PROJECT_ID=your-gcp-project-id
FIRESTORE_CREDENTIALS_PATH=./secrets/firestore-service-account.json
# Free-tier-safe LOCAL DEV: run `docker compose --profile emulator up` and
# UNCOMMENT the next line so every service uses the local Firestore emulator
# instead of real GCP — no service-account JSON, no cloud spend. Leave it
# commented for staging/prod (then FIRESTORE_PROJECT_ID + credentials are used).
# FIRESTORE_EMULATOR_HOST=firestore:8080

# Internal service URLs (used inside docker-compose network)
PROMETHEUS_URL=http://prometheus:9090
# INBOUND: the URL your agent/execution code POSTs a Prometheus alert TO, to
# kick off the n8n workflow. (Distinct from n8n's own WEBHOOK_URL below.)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/aic
LANGGRAPH_API_URL=http://agent:8001
EXECUTION_API_URL=http://execution:8000
# FULL LOCAL DEMO with the thin mocks (profile `mocks`) instead of JP/Ayman's
# real services — uncomment these two and run `--profile emulator --profile mocks`:
# LANGGRAPH_API_URL=http://mock-langgraph:8001
# EXECUTION_API_URL=http://mock-execution:8000

# --- n8n engine config (orchestration / Tarik) ------------------------------
# These configure n8n ITSELF (not the same as N8N_WEBHOOK_URL above).
# WEBHOOK_URL is the base n8n uses to build "Wait for Webhook" RESUME URLs, and
# must be reachable by whoever resumes the paused workflow. The Approval API
# runs in a container on the `aic` network, so the service hostname below is
# correct by default. For manual host-side curl testing of the resume URL,
# override to WEBHOOK_URL=http://localhost:5678/.
N8N_HOST=n8n
N8N_PROTOCOL=http
WEBHOOK_URL=http://n8n:5678/
# Stable credential-encryption key (else n8n makes a new one each volume reset
# and orphans stored credentials). Generate: openssl rand -hex 16
N8N_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_hex_16
# false for plain-HTTP localhost dev; set true behind HTTPS.
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=America/New_York

# --- Generic Approval API (orchestration / Tarik) ---------------------------
# Where other services (n8n) reach the Approval API inside the compose network.
APPROVAL_API_URL=http://approval_api:8080
# Service token gating the WRITE endpoints (POST /approvals, /decide, /resume),
# sent as `Authorization: Bearer <token>`. The API fails CLOSED (503) if this is
# unset in non-emulator mode, so a prod deploy can't run open. In emulator dev a
# missing token is allowed. Generate: openssl rand -hex 24
API_SERVICE_TOKEN=CHANGE_ME_run_openssl_rand_hex_24
# Browser origins allowed to call the API (the Route A Web UI). Empty = no CORS
# middleware (the safe default). Never wildcard with credentials.
CORS_ALLOW_ORIGINS=http://localhost:3000
# SSRF allowlist for the outbound n8n resume POST — only these hosts may be
# targeted by the caller-supplied resume URL. Defaults shown; widen deliberately.
# N8N_RESUME_ALLOWED_HOSTS=n8n,localhost,127.0.0.1

# --- Slack Route-B adapter (orchestration / Tarik) --------------------------
# Opt-in service (compose profile `slack`). Create a Slack app, then set these.
# See orchestration/slack-adapter/README.md. Leave blank to keep it disabled.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
# SLACK_CHANNEL_ID=C0123ABC

# Optional: other Route B notification hooks
# PAGERDUTY_ROUTING_KEY=...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
