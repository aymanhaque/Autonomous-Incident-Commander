# Leave empty for k8s/Docker — nginx proxies /approvals/ to the in-cluster approval-api.
# Set to http://localhost:8080 only when running the approval-api directly without nginx.
VITE_API_BASE_URL=
VITE_MOCK=0
VITE_OPERATOR_ID=ui:tarik@aic
# Matches the API's API_SERVICE_TOKEN. Leave empty in emulator dev (token optional there);
# set it for staging/prod so the authenticated write calls (decide) are accepted.
VITE_API_TOKEN=
